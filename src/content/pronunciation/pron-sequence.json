  "u20": {
   "title": "El acento final de los conectores",
   "tip": "Los conectores con tilde final se acentúan en la última sílaba: *perché*, *però*, *così*. En *quindi* y *comunque* la *u* se oye (*kw*). En *insomma* la *mm* es doble. Compara *però* (pero) con *pero* (peral).",
   "pairs": [
    [
     "però",
     "pero"
    ]
   ],
   "words": [
    "perché",
